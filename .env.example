# Telegram API credentials
# Get from https://my.telegram.org
API_ID=your_api_id
API_HASH=your_api_hash
PHONE=your_phone_number

# Target group usernames (without @)
# Multiple groups: use comma-separated values
# Example: GROUP_USERNAMES=group1,group2,group3
GROUP_USERNAMES=your_group_username

# Optional: Date range for filtering messages
# Leave empty to crawl all messages
# Format: YYYY-MM-DD
# START_DATE=2024-01-01
# END_DATE=2024-01-31
